PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET=your_random_jwt_secret_here
DEEPSEEK_API_KEY=your_deepseek_api_key
STRIPE_SECRET_KEY=your_stripe_secret
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRICE_ID=your_stripe_price_id
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-backend-domain/api/google/callback
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=https://your-vercel-domain.vercel.app
BACKEND_URL=https://your-backend-domain
SKIP_DB_INIT=0
# Demo account (created by `npm run seed:demo`; the login page shows an
# "Explore the live demo" button when it exists)
# Leave unset to verify the Postgres TLS certificate (recommended).
# Set to false only if your host's CA is not trusted by Node.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
DEMO_EMAIL=demo@localproof.app
DEMO_PASSWORD=demo1234
